# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Groq (free tier — https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding model (loaded locally via sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval settings
SIMILARITY_THRESHOLD=0.35
TOP_K_CHUNKS=5

# Frontend URL (for CORS and embed snippet generation)
FRONTEND_URL=http://localhost:3000

# Rate limiting (for widget chat endpoint)
RATE_LIMIT=30/minute

# Clerk Authentication
# Get from https://dashboard.clerk.com → your app → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_c3VpdGFibGUtcm9vc3Rlci02Ny5jbGVyay5hY2NvdW50cy5kZXYk
